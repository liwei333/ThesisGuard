# WeKnora environment for ThesisGuard integration
# Copy from WeKnora's .env.example with minimal settings

# Database (uses its own PostgreSQL, separate from ThesisGuard)
# For local dev, you can point to the same PostgreSQL instance with a different DB name
DB_HOST=postgres
DB_PORT=5432
DB_USER=weknora
DB_PASSWORD=weknora
DB_NAME=weknora

# API Key for ThesisGuard to authenticate
API_KEY=thesisguard-local-dev-key-change-in-production

# Embedding model (configure if you have a local embedding endpoint)
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSION=1536

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/data/files

# Disable features not needed
ENABLE_SANDBOX=false
ENABLE_MCP=false
ENABLE_WIKI=false
