# ThesisGuard Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.

# ===========================================
# PostgreSQL
# ===========================================
POSTGRES_USER=thesisguard
POSTGRES_PASSWORD=thesisguard_dev_password
POSTGRES_DB=thesisguard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://thesisguard:thesisguard_dev_password@postgres:5432/thesisguard

# ===========================================
# Redis
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
REDIS_QUEUE_URL=redis://redis:6379/2

# ===========================================
# MinIO (S3-compatible Object Storage)
# ===========================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=thesisguard-documents
MINIO_REGION=us-east-1
MINIO_SECURE=false

# ===========================================
# API
# ===========================================
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
API_DEBUG=true
API_LOG_LEVEL=INFO

# ===========================================
# Worker
# ===========================================
WORKER_CONCURRENCY=4
WORKER_LOG_LEVEL=INFO

# ===========================================
# Web (Frontend)
# ===========================================
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=ThesisGuard

# ===========================================
# External Services (placeholder for future WPs)
# ===========================================
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# TONGHUASHUN_MCP_URL=
